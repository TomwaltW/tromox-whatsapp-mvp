# Tromox webhook service - configuration template.
# Copy to `.env` (git-ignored) and fill in. Never commit real values. All names are frozen
# in the integration contract; see README.md for the full table.

# --- Inbound security ---------------------------------------------------------------------
# Must equal the "token" configured on the Botmaker webhook (Settings > Integrations >
# Botmaker API). Botmaker sends it in the `auth-bm-token` header. While empty, the service
# answers 503 on /webhooks/botmaker. Generate one with: openssl rand -hex 32
BOTMAKER_WEBHOOK_TOKEN=
# Optional defence in depth: comma-separated IPs / CIDRs allowed to call the webhook
# (Botmaker publishes its egress IP list, SOURCES S-B11). Empty = no IP filtering.
ALLOWED_IPS=
# Behind a reverse proxy, tell uvicorn which proxy may set X-Forwarded-For (uvicorn reads
# this variable natively). Example: the docker bridge gateway or 127.0.0.1.
# FORWARDED_ALLOW_IPS: with docker compose this is set by the compose file (TROMOX_FORWARDED_ALLOW_IPS,
# default * because port 8000 is bound to 127.0.0.1 and Caddy is the only ingress); a value here
# is overridden by compose. Only set it when running uvicorn directly behind your own proxy.

# --- Storage --------------------------------------------------------------------------------
DATABASE_PATH=data/leads.db
CSV_EXPORT_PATH=data/leads.csv
# CSV mirror write-behind: a single callback is written immediately, a burst is coalesced
# into one rewrite per interval (seconds), and the service writes what is still pending
# when it shuts down. 0 = rewrite on every callback (the old behaviour).
CSV_EXPORT_MIN_INTERVAL_S=5
# sqlite is always on (it is the ledger). Add csv for the spreadsheet mirror and
# feishu_bitable to mirror every lead into a Feishu Bitable (needs the four FEISHU_* values
# below; setup steps in ../feishu-bitable-setup.md). gsheets is still a documented stub and
# makes the service refuse to start.
STORAGE_BACKENDS=sqlite,csv
# Feishu Bitable mirror. App ID / App Secret of the self-built app (open platform > app >
# credentials). The secret is a secret: .env or the deployment platform's secret store only.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# From the Bitable's URL: the segment after /base/ is the app token, the value of the
# table= query parameter (tbl...) is the table id. The app must be added to the Bitable as
# an editor (see the setup doc). All four are required once feishu_bitable is enabled.
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# Feishu open platform origin. Empty = https://open.feishu.cn (mainland Feishu). An
# overseas Lark tenant sets https://open.larksuite.com. Must start with https://.
FEISHU_BASE_URL=
# Trial only: keep raw callbacks in raw_events to capture real payload samples.
# Leave false in production so chat content does not accumulate in the lead store.
KEEP_RAW_PAYLOADS=false

# --- Sales notifications ----------------------------------------------------------------
# Comma list of: feishu | wecom | generic | email. Empty = no notification (logged as a warning).
NOTIFIERS=feishu
# Feishu group > Settings > Bots > Custom bot: copy the webhook address. Treat it as a secret.
FEISHU_WEBHOOK_URL=
# Only when the bot has "signature verification" switched on.
FEISHU_SIGNING_SECRET=
# WeCom group > Add group bot: copy the webhook address (contains the key). Treat it as a secret.
WECOM_WEBHOOK_URL=
# Any endpoint accepting a JSON POST: {"event": "lead_escalated", "text": "...", "card": {...}}
GENERIC_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated recipients.
EMAIL_TO=
# true = the card shows only the last 4 digits of the customer's number (recommended).
NOTIFY_MASK_PHONE=true
# Link on the card. {customer_id} is Botmaker's customerId / chatId. Exact URL pattern to be verified.
BOTMAKER_CHAT_URL_TEMPLATE=https://go.botmaker.com/#/chats/{customer_id}
# Time zone used for the 24-hour window deadline on the card.
DISPLAY_TIMEZONE=Asia/Shanghai

# --- Behaviour ------------------------------------------------------------------------------
# full = 9 tag dimensions, lite = country + segment only (matches the two quotation tiers).
TAG_TIER=full
LOG_LEVEL=INFO
