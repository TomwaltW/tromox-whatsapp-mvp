    },
    "profile_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Name"
    },
    "company": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Company"
    },
    "role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role"
    },
    "segment": {
      "$ref": "#/$defs/Segment",
      "default": "unknown"
    },
    "b2b_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/B2BType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "b2c_intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/B2CIntent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
