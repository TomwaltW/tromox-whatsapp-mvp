{
  "$defs": {
    "B2BType": {
      "enum": [
        "dealer",
        "distributor",
        "fleet",
        "importer",
        "other"
      ],
      "title": "B2BType",
      "type": "string"
    },
    "B2CIntent": {
      "enum": [
        "buy",
        "support",
        "parts",
        "warranty",
        "test_ride",
        "other"
      ],
      "title": "B2CIntent",
      "type": "string"
    },
    "EscalationReason": {
      "description": "Why the conversation must be handed to a human (01-design/routing-rules.md).",
      "enum": [
        "human_requested",
        "b2b_qualified",
        "low_confidence",
        "complaint_warranty_legal_safety",
        "price_negotiation",
        "not_understood_twice"
      ],
      "title": "EscalationReason",
      "type": "string"
    },
    "LeadStatus": {
      "enum": [
        "new",
        "qualified",
        "handed_off",
        "contacted",
        "closed_won",
        "closed_lost",
        "nurture",
        "invalid"
      ],
      "title": "LeadStatus",
      "type": "string"
    },
    "Referral": {
      "description": "Click-to-WhatsApp ad referral. Whether Botmaker passes it through is 【待核实】.",
      "properties": {
        "source_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Type"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headline"
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "ctwa_clid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ctwa Clid"
        }
      },
      "title": "Referral",
      "type": "object"
    },
    "Segment": {
      "enum": [
        "B2B",
        "B2C",
        "unknown"
      ],
      "title": "Segment",
      "type": "string"
    },
    "SourceChannel": {
      "enum": [
        "instagram",
        "facebook",
        "tiktok",
        "youtube",
        "website",
        "ctwa_ad",
        "offline_qr",
        "other",
        "unknown"
      ],
      "title": "SourceChannel",
      "type": "string"
    }
  },
  "description": "Full lead record. One lead per contact.\n\nThe dedupe key is the E.164 phone number. When the platform delivers no phone number\n(a customer reaching the business through a WhatsApp username only exposes a\nbusiness-scoped user id), `phone` is None and the lead is keyed by the platform's\ncustomer id instead - see `tromox_lead.ids.contact_key`.",
  "properties": {
    "lead_id": {
      "title": "Lead Id",
      "type": "string"
    },
    "phone": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phone"
    },
    "country_by_phone": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
