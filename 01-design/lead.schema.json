    "product_interest": {
      "items": {
        "type": "string"
      },
      "title": "Product Interest",
      "type": "array"
    },
    "volume": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Volume"
    },
    "city_region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "City Region"
    },
    "existing_dealer_relationship": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Existing Dealer Relationship"
    },
    "source_channel": {
      "$ref": "#/$defs/SourceChannel",
      "default": "unknown"
    },
    "source_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Code"
    },
    "referral": {
      "anyOf": [
        {
          "$ref": "#/$defs/Referral"
        },
        {
          "type": "null"
        }
      ],
      "default": null
